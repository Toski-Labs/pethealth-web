---
/** Suporte (PT e EN): contato, código de suporte e perguntas frequentes. Sem JavaScript. */
import { Card, Icon, IconBox, Kicker, SectionHeading, buttonClasses } from '@toski-labs/ds';
import { faq } from '../../data/faq';
import { getLang, href, SUPPORT_EMAIL } from '../../i18n/ui';
import FaqItem from '../ui/FaqItem.astro';

const lang = getLang(Astro.currentLocale);
const t = {
  pt: {
    kicker: 'Suporte',
    title: 'Como podemos ajudar?',
    lead: 'As respostas mais comuns estão aqui embaixo. Se não achar o que precisa, fale com a gente.',
    contactLabel: 'Contato',
    mailTitle: 'Fale com a gente',
    mailBody: 'Mande um e-mail para',
    mailBodyEnd: 'Respondemos em até 2 dias úteis.',
    mailCta: 'Escrever e-mail',
    mailSubject: 'Suporte PetHealthTracker',
    mailWeb: 'no navegador',
    mailApp: 'App de e-mail',
    mailAppHint: 'Mail ou o app do seu aparelho',
    codeTitle: 'Inclua o seu código de suporte',
    codeBody: 'Ele ajuda a encontrar a sua conta sem você precisar mandar dados pessoais. Para copiar no app:',
    codeSteps: ['Ajustes', 'Ajuda e feedback', 'Sua conta', 'Copiar código'],
    codeStepsLabel: 'Caminho no app',
    faqTitle: 'Perguntas frequentes',
    faqLead: 'Sobre assinatura, conta e lembretes do PetHealthTracker.',
    privLine: 'Quer saber o que fazemos com os seus dados?',
    privCta: 'Ler a Política de Privacidade',
  },
  en: {
    kicker: 'Support',
    title: 'How can we help?',
    lead: 'The most common answers are below. If you can’t find what you need, get in touch.',
    contactLabel: 'Contact',
    mailTitle: 'Get in touch',
    mailBody: 'Email',
    mailBodyEnd: 'We reply within 2 business days.',
    mailCta: 'Send an email',
    mailSubject: 'PetHealthTracker support',
    mailWeb: 'in your browser',
    mailApp: 'Email app',
    mailAppHint: 'Mail or your device’s app',
    codeTitle: 'Include your support code',
    codeBody: 'It helps us find your account without you sending any personal details. To copy it in the app:',
    codeSteps: ['Settings', 'Help & feedback', 'Your account', 'Copy code'],
    codeStepsLabel: 'Path in the app',
    faqTitle: 'FAQ',
    faqLead: 'About PetHealthTracker subscriptions, accounts and reminders.',
    privLine: 'Want to know what we do with your data?',
    privCta: 'Read the Privacy Policy',
  },
}[lang];
const mailto = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(t.mailSubject)}`;
// Para quem não tem app de e-mail configurado o mailto não abre nada: o botão abre um menu com Gmail e Outlook no navegador.
const gmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${SUPPORT_EMAIL}&su=${encodeURIComponent(t.mailSubject)}`;
const outlook = `https://outlook.live.com/mail/0/deeplink/compose?to=${SUPPORT_EMAIL}&subject=${encodeURIComponent(t.mailSubject)}`;
---

<section aria-labelledby="suporte-titulo" class="page pt-10 pb-10">
  <SectionHeading id="suporte-titulo" as="h1" kicker={t.kicker} title={t.title} lead={t.lead} />
</section>

<section aria-label={t.contactLabel} class="page flex flex-wrap gap-6 pb-22">
  <Card radius="panel" className="flex min-w-0 flex-[1_1_340px] flex-col gap-3.5 p-8">
    <IconBox name="mail" />
    <h2 class="mt-1 text-2xl font-semibold">{t.mailTitle}</h2>
    <!-- O endereço fica visível e selecionável: quem não tem app de e-mail configurado copia daqui. -->
    <p class="text-base leading-normal text-muted">{t.mailBody} <strong class="font-semibold text-ink select-all">{SUPPORT_EMAIL}</strong>. {t.mailBodyEnd}</p>
    <div class="mt-1.5 flex flex-wrap gap-2.5">
      <!-- <details> nativo: abre e fecha sem JavaScript. -->
      <details class="group relative max-sm:flex-auto">
        <summary class={buttonClasses('primary', 'md', 'w-full cursor-pointer list-none [&::-webkit-details-marker]:hidden')}>
          {t.mailCta}<Icon name="chevron-down" size={18} stroke={2.2} className="transition-transform group-open:rotate-180" />
        </summary>
        <ul role="list" class="toski-menu absolute top-full left-0 z-20 mt-2 flex w-max min-w-full flex-col gap-0.5 rounded-card border border-line bg-surface p-1.5 shadow-[0_18px_44px_rgba(35,27,23,0.18)] [--menu-origin:top_left]">
          {[
            { label: 'Gmail', hint: t.mailWeb, href: gmail, external: true },
            { label: 'Outlook', hint: t.mailWeb, href: outlook, external: true },
            { label: t.mailApp, hint: t.mailAppHint, href: mailto, external: false },
          ].map((o) => (
            <li>
              <a
                href={o.href}
                target={o.external ? '_blank' : undefined}
                rel={o.external ? 'noopener' : undefined}
                class="flex min-h-11 flex-col justify-center rounded-[10px] px-3 py-1.5 leading-tight text-ink no-underline hover:bg-tint hover:text-ink"
              >
                <span class="text-[15px] font-semibold">{o.label}</span>
                <span class="text-xs text-muted">{o.hint}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </Card>
  <Card variant="hero" radius="panel" className="flex min-w-0 flex-[1_1_340px] flex-col gap-3.5 p-8">
    <IconBox name="copy" on="surface" />
    <h2 class="mt-1 text-2xl font-semibold">{t.codeTitle}</h2>
    <p class="text-base leading-normal text-muted">{t.codeBody}</p>
    <ol role="list" aria-label={t.codeStepsLabel} class="mt-1.5 flex flex-wrap items-center gap-2">
      {t.codeSteps.map((step) => (
        <li class="inline-flex h-8.5 items-center rounded-[10px] bg-surface px-3 text-sm font-medium">{step}</li>
      ))}
    </ol>
  </Card>
</section>

<section aria-labelledby="faq-titulo" class="band bg-hero">
  <div class="page flex flex-wrap gap-x-16 gap-y-8 pt-20 pb-24">
    <div class="flex min-w-0 flex-[1_1_260px] flex-col gap-2.5">
      <Kicker>PetHealthTracker</Kicker>
      <h2 id="faq-titulo" class="text-[clamp(30px,3.6vw,42px)] leading-[1.1] font-semibold tracking-[-0.02em]">{t.faqTitle}</h2>
      <p class="text-base leading-normal text-muted">{t.faqLead}</p>
    </div>
    <div class="flex min-w-0 flex-[999_1_560px] flex-col gap-2.5">
      {faq[lang].map(([q, a]) => <FaqItem question={q}><p>{a}</p></FaqItem>)}
    </div>
  </div>
</section>

<section aria-label={t.privCta} class="page flex flex-wrap items-center justify-between gap-4 pt-14 pb-20">
  <p class="text-[17px] text-muted">{t.privLine}</p>
  <a href={href(lang, 'privacy')} class="inline-flex min-h-11 items-center text-base font-semibold no-underline hover:underline">{t.privCta}</a>
</section>
