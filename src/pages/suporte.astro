---
import BaseLayout from '../layouts/BaseLayout.astro';
import SupportPage from '../components/pages/SupportPage.astro';
import { seo } from '../data/seo';
import { routes } from '../i18n/ui';
import { faqPage } from '../lib/schema';

const { title, description } = seo.pt.support;
void routes;
---

<BaseLayout page="support" title={title} description={description} graph={[faqPage('pt', new URL(routes.pt.support, Astro.site).href)]}>
  <SupportPage />
</BaseLayout>
