---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PawtaPage from '../../components/pages/PawtaPage.astro';
import { seo } from '../../data/seo';
import { mobileApplication } from '../../lib/schema';

const { title, description } = seo.en.app;
---

<BaseLayout page="app" title={title} description={description} graph={[mobileApplication(Astro.site!, new URL('/en', Astro.site).href, description)]}>
  <PawtaPage />
</BaseLayout>
