{
  "hosting": [
    {
      "target": "pawta",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
          ]
        },
        {
          "source": "/_astro/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    },
    {
      "target": "pethealth",
      "public": "redirect",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        { "source": "/", "destination": "https://pawta.toski-labs.com.br/", "type": 301 },
        { "source": "/en", "destination": "https://pawta.toski-labs.com.br/en", "type": 301 },
        { "source": "/privacidade", "destination": "https://pawta.toski-labs.com.br/privacidade", "type": 301 },
        { "source": "/en/privacy", "destination": "https://pawta.toski-labs.com.br/en/privacy", "type": 301 },
        { "source": "/suporte", "destination": "https://pawta.toski-labs.com.br/suporte", "type": 301 },
        { "source": "/en/support", "destination": "https://pawta.toski-labs.com.br/en/support", "type": 301 },
        { "source": "/:path*", "destination": "https://pawta.toski-labs.com.br/:path", "type": 301 }
      ]
    }
  ]
}
